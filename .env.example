POSTGRES_DB=seoulaim
POSTGRES_USER=seoulaim
POSTGRES_PASSWORD=local

DB_URL=jdbc:postgresql://localhost:5433/seoulaim
DB_USERNAME=seoulaim
DB_PASSWORD=local

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=14d

# 관리자 API 임시 인증 키 (X-Admin-Key). dev/prod 필수
ADMIN_KEY=

# 토스페이먼츠 (테스트 키. 가맹 신청 후 계정 키로 교체)
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 선택, 기본 3000
ORDER_SHIPPING_FEE=3000